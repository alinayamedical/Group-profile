%%EndPageSetup

gsave

% ═══════════════════════════════════════════════════════
% ALINAYA ALRAFIA MEDICAL COMPANY
% Logo Icon Mark — Full Color
% Abstract Wedge (Shape H) — Approved July 2026
%
% BRAND COLORS
%   Primary Emerald     #1B4D3E   RGB(27,  77,  62)
%   Accent Gold         #C9A84C   RGB(201, 168, 76)
%   Emerald 62% opacity #7A9189   RGB(122, 145, 137)  [pre-multiplied on white]
%
% NOTE: The right triangle carries 62% opacity in the
% digital SVG files. This EPS uses a pre-multiplied
% flat color for print compatibility. When editing in
% Illustrator, restore transparency (62% opacity) on
% the right triangle layer for screen use.
% ═══════════════════════════════════════════════════════

% ── LEFT UPPER TRIANGLE  (Emerald, solid) ────────────────────
% SVG path: M10,70 L70,8 L70,70 Z
0.106 0.302 0.243 setrgbcolor
newpath
10  70 moveto
70 132 lineto
70  70 lineto
closepath
fill

% ── RIGHT UPPER TRIANGLE  (Emerald 62% on white) ─────────────
% SVG path: M130,70 L70,8 L70,70 Z  opacity=0.62
% Pre-multiplied with white: R=122 G=145 B=137
0.478 0.569 0.537 setrgbcolor
newpath
130  70 moveto
70  132 lineto
70   70 lineto
closepath
fill

% ── GOLD DIAMOND  (Gold, solid) ──────────────────────────────
% SVG path: M10,70 L70,132 L130,70 L70,70 Z
0.788 0.659 0.298 setrgbcolor
newpath
10  70 moveto
70   8 lineto
130  70 lineto
70   70 lineto
closepath
fill

grestore

%%Trailer
%%EOF
